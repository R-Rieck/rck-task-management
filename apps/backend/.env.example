APP_DB_URL=jdbc:postgresql://localhost:5432/taskmanagement
APP_DB_USERNAME=admin
APP_DB_PASSWORD=admin

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
APP_CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_ALLOW_CREDENTIALS=false

APP_JWT_ACCESS_TOKEN_SECRET=replace-with-64-byte-hex
APP_JWT_ACCESS_TOKEN_EXPIRATION=900000
APP_JWT_REFRESH_TOKEN_SECRET=replace-with-64-byte-hex
APP_JWT_REFRESH_TOKEN_EXPIRATION=604800000
