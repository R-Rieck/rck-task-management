extend type Query {
    boards(projectId: ProjectId!): [BoardType!]!
    board(id: BoardId!): BoardType!
}

extend type Mutation {
    createBoard(input: CreateBoardInput!): BoardType!
    deleteBoard(boardId: BoardId!): Boolean!
    createBoardSection(input: CreateBoardSectionInput!): BoardSectionType!
    deleteBoardSection(sectionId: BoardSectionId!): Boolean!
    renameBoardSection(sectionId: BoardSectionId!, name: String!): BoardSectionType!
}

type BoardType {
    id: BoardId!
    name: String!
    sections: [BoardSectionType!]!
    createdAt: DateTime!
    updatedAt: DateTime!
}

type BoardSectionType {
    id: BoardSectionId!
    name: String!
    position: Int!
}

input CreateBoardInput {
    projectId: ProjectId!
    name: String!
    sections: [String!]!
}

input CreateBoardSectionInput {
    boardId: BoardId!
    name: String!
    position: Int
}
